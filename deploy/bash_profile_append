# Apple Pi Diagnostics — auto-start GUI on tty1
# Appended to /home/pi/.bash_profile by setup-image.sh.
# Only triggers on the physical console (not SSH), and only if X is not already running.
if [ -z "$DISPLAY" ] && [ "$(tty)" = "/dev/tty1" ]; then
    exec startx /opt/apple-pi-diagnostics/deploy/xinitrc -- :0 -nocursor 2>/tmp/apd-x11.log
fi
